# 复制为 .env 后填真实值，.env 本身不进 git。
# DATABASE_URL 由 docker-compose.yml 固定指向 db 服务，此处不需要配。

# JWT 签名密钥，必填，生产环境务必换成随机长字符串
JWT_SECRET=

# 管理台登录账号，默认 admin
ADMIN_USERNAME=admin

# 管理台登录密码，必填
ADMIN_PASSWORD=

# AI 服务（可选；留空时服务照常启动，但 AI 对话返回 503）
AI_API_KEY=
# 默认 https://api.deepseek.com/v1，可替换为任意 OpenAI 兼容地址
AI_BASE_URL=
# 默认 deepseek-chat
AI_MODEL=
